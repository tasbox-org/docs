{
  "name": "@tasbox-org/docs",
  "author": "TASBox",
  "version": "1.1.0",
  "license": "MIT",
  "description": "JSON documentation for the TASBox scripting API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc --declaration",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "generate-schema": "ts-json-schema-generator --path './src/interfaces/*.ts' --strict-tuples --type Library --out ./schema.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tasbox-org/docs.git"
  },
  "bugs": {
    "url": "https://github.com/tasbox-org/docs/issues"
  },
  "homepage": "https://github.com/tasbox-org/docs#readme",
  "devDependencies": {
    "prettier": "^3.7.4",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.9.3"
  }
}
